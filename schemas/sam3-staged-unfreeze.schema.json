{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/sam3-staged-unfreeze.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "current_verified_stage", "runtime_inventory_gate", "conditional_expansion", "unverified_module_policy", "holdout_gate", "full_model_policy"],
  "properties": {
    "schema_version": {"const": "labelagent.sam3-conditional-unfreeze.v2"},
    "scope": {"const": "future_training_plan_not_training_execution"},
    "current_verified_stage": {
      "type": "object", "additionalProperties": false,
      "required": ["stage", "name", "status", "trainable_prefixes", "runtime_exact_parameter_names_status", "runtime_trainable_parameter_count_status", "config_sha256_status", "independent_holdout_gain_status", "rollback_to"],
      "properties": {
        "stage": {"const": 0},
        "name": {"const": "mask_embed_only_minimal_reversible_baseline"},
        "status": {"const": "only_currently_verified_trainable_scope"},
        "trainable_prefixes": {"const": ["segmentation_head.mask_predictor.mask_embed."]},
        "runtime_exact_parameter_names_status": {"const": "verified_dual_5090_inventory_receipt"},
        "runtime_trainable_parameter_count_status": {"const": "verified_197376"},
        "config_sha256_status": {"const": "required_before_training"},
        "independent_holdout_gain_status": {"const": "pending_human_truth_and_baseline"},
        "rollback_to": {"const": "original_sam3_checkpoint_with_sha256"}
      }
    },
    "runtime_inventory_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["dual_5090_named_parameters_verified", "inventory_receipt", "forward_backward_dependency_verified", "genuine_human_truth_version_available", "fixed_holdout_baseline_available", "all_prerequisites_required_for_expansion"],
      "properties": {
        "dual_5090_named_parameters_verified": {"const": true},
        "inventory_receipt": {"const": "docs/test-results/dual-gpu-infrastructure-live-readback-20261111.json"},
        "forward_backward_dependency_verified": {"const": false},
        "genuine_human_truth_version_available": {"const": false},
        "fixed_holdout_baseline_available": {"const": false},
        "all_prerequisites_required_for_expansion": {"const": true}
      }
    },
    "conditional_expansion": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "predeclared_stages", "predeclared_trainable_prefixes", "candidate_must_be_derived_from_live_named_parameters", "predeclared_target_families", "future_scope_generation", "required_stage_record_fields"],
      "properties": {
        "enabled": {"const": false},
        "predeclared_stages": {"const": []},
        "predeclared_trainable_prefixes": {"const": []},
        "candidate_must_be_derived_from_live_named_parameters": {"const": true},
        "predeclared_target_families": {"const": []},
        "future_scope_generation": {"const": "new_config_from_dual_5090_exact_named_parameters_only_after_all_prerequisites"},
        "required_stage_record_fields": {"const": ["exact_trainable_parameter_names", "trainable_parameter_count", "training_config_sha256", "independent_holdout_baseline_metrics", "independent_holdout_candidate_metrics", "independent_holdout_gain", "rollback_checkpoint_path", "rollback_checkpoint_sha256"]}
      }
    },
    "unverified_module_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["mask_decoder_exists_or_is_verified_trainable", "adapter_exists_or_is_verified_trainable", "lora_exists_or_is_verified_trainable", "claims_forbidden_until_runtime_evidence"],
      "properties": {
        "mask_decoder_exists_or_is_verified_trainable": {"const": false},
        "adapter_exists_or_is_verified_trainable": {"const": false},
        "lora_exists_or_is_verified_trainable": {"const": false},
        "claims_forbidden_until_runtime_evidence": {"const": true}
      }
    },
    "holdout_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["comparison", "required_metrics", "threshold_status", "thresholds_must_be_versioned_before_training", "promotion_rule", "protected_sets"],
      "properties": {
        "comparison": {"const": "candidate_vs_original_sam3_on_same_fixed_independent_holdout"},
        "required_metrics": {"const": ["pixel_recall", "mask_iou", "boundary_f1"]},
        "threshold_status": {"const": "pending_human_truth_calibration"},
        "thresholds_must_be_versioned_before_training": {"const": true},
        "promotion_rule": {"const": "expand_only_after_stage0_fails_versioned_gate_and_all_runtime_prerequisites_pass"},
        "protected_sets": {"const": ["test24", "fixed_640_holdout"]}
      }
    },
    "full_model_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "authorization_allowed"],
      "properties": {
        "enabled": {"const": false},
        "authorization_allowed": {"const": false}
      }
    }
  }
}
