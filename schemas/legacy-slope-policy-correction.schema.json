{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/legacy-slope-policy-correction.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "correction_id",
    "occurred_at",
    "immutable",
    "archival_binding",
    "superseded_by",
    "new_policy",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "labelagent.legacy-slope-policy-correction.v1"},
    "correction_id": {"type": "string", "pattern": "^corr-legacy-slope-[a-z0-9-]+$"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "immutable": {"const": true},
    "archival_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_artifact_path",
        "old_artifact_sha256",
        "old_event_id",
        "legacy_identifier",
        "archival_only",
        "current_ingest_allowed"
      ],
      "properties": {
        "old_artifact_path": {"type": "string", "minLength": 1},
        "old_artifact_sha256": {"$ref": "#/$defs/hash"},
        "old_event_id": {"type": ["string", "null"], "minLength": 1},
        "legacy_identifier": {"type": "string", "minLength": 1},
        "archival_only": {"const": true},
        "current_ingest_allowed": {"const": false}
      }
    },
    "superseded_by": {"type": "string", "pattern": "^corr-legacy-slope-[a-z0-9-]+$"},
    "new_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label_type",
        "semantic_label",
        "business_mapping",
        "downstream_mapping",
        "traversability_status",
        "policy_basis",
        "human_pixel_truth_available",
        "approved_for_training"
      ],
      "properties": {
        "label_type": {"const": "slope"},
        "semantic_label": {"const": "slope_visible"},
        "business_mapping": {"const": "traversable_area"},
        "downstream_mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "source_labels", "target_label", "preserve_source_labels"],
          "properties": {
            "operation": {"const": "union"},
            "source_labels": {"const": ["floor", "slope"]},
            "target_label": {"const": "traversable_area"},
            "preserve_source_labels": {"const": true}
          }
        },
        "traversability_status": {"const": "passable"},
        "policy_basis": {"const": "user_defined_project_semantics"},
        "human_pixel_truth_available": {"const": false},
        "approved_for_training": {"const": false}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "old_artifact_modified",
        "machine_candidate_only",
        "truth_committed",
        "training_ready"
      ],
      "properties": {
        "old_artifact_modified": {"const": false},
        "machine_candidate_only": {"const": true},
        "truth_committed": {"const": false},
        "training_ready": {"const": false}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
