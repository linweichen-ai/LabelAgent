{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/historical-evidence-restoration-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "audit_range",
    "restore_source",
    "history_rewritten",
    "selection_rule",
    "supersedes_prior_restore_receipt",
    "restored_artifact_count",
    "restored_artifacts",
    "correction_schema",
    "schema_validation"
  ],
  "properties": {
    "schema_version": {"const": "labelagent.historical-evidence-restoration-manifest.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "audit_range": {"const": "cc20fb0..1e640d2"},
    "restore_source": {"const": "cc20fb0"},
    "history_rewritten": {"const": false},
    "selection_rule": {"const": "changed_under_docs_test-results_and_already_exists_at_cc20fb0"},
    "supersedes_prior_restore_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "correction_scope", "prior_restored_file_count", "corrected_restored_file_count", "prior_artifact_modified"],
      "properties": {
        "path": {"const": "docs/test-results/immutable-evidence-peft-prep-receipt-20261111.json"},
        "sha256": {"$ref": "#/$defs/hash"},
        "correction_scope": {"const": "restored_file_count_and_prior_artifact_inventory_only"},
        "prior_restored_file_count": {"const": 9},
        "corrected_restored_file_count": {"const": 11},
        "prior_artifact_modified": {"const": false}
      }
    },
    "restored_artifact_count": {"const": 11},
    "restored_artifacts": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {"$ref": "#/$defs/restored_artifact"}
    },
    "correction_schema": {"const": "schemas/historical-evidence-superseding-correction.schema.json"},
    "schema_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_errors", "correction_files_validated", "correction_errors"],
      "properties": {
        "manifest_errors": {"const": 0},
        "correction_files_validated": {"const": 11},
        "correction_errors": {"const": 0}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "restored_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "cc20_blob",
        "sha256",
        "exact_blob_restored",
        "correction_event_path",
        "correction_event_sha256",
        "correction_event_id"
      ],
      "properties": {
        "path": {"type": "string", "pattern": "^docs/test-results/.+"},
        "cc20_blob": {"$ref": "#/$defs/blob"},
        "sha256": {"$ref": "#/$defs/hash"},
        "exact_blob_restored": {"const": true},
        "correction_event_path": {"type": "string", "pattern": "^docs/test-results/.+\\.superseding-correction\\.json$"},
        "correction_event_sha256": {"$ref": "#/$defs/hash"},
        "correction_event_id": {"type": "string", "pattern": "^corr-supersede-[a-z0-9-]+$"}
      }
    }
  }
}
