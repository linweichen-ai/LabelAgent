{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/factory-labelagent-orchestration-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "event_key", "event_type", "occurred_at", "trace_id", "stream_id", "batch_key", "previous_event_id", "state_version", "previous_state", "state", "operational_status", "identity", "bindings", "retry", "queue", "human_gate", "provenance", "label_policy", "classification", "agent_action", "reason_codes", "failure_reason", "artifacts", "contract_refs", "evaluation", "truth_version", "training_run", "effect"],
  "properties": {
    "schema_version": {"const": "labelagent.factory-orchestration-event.v1"},
    "event_id": {"$ref": "#/$defs/sha"}, "event_key": {"$ref": "#/$defs/sha"},
    "event_type": {"enum": ["state.transition", "operation.failed", "operation.retry_released", "queue.backpressure_applied", "queue.backpressure_released"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "trace_id": {"type": "string", "minLength": 1}, "stream_id": {"$ref": "#/$defs/sha"}, "batch_key": {"$ref": "#/$defs/sha"},
    "previous_event_id": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "state_version": {"type": "integer", "minimum": 1},
    "previous_state": {"oneOf": [{"$ref": "#/$defs/state"}, {"type": "null"}]}, "state": {"$ref": "#/$defs/state"},
    "operational_status": {"enum": ["ready", "retry_wait", "backpressured", "dead_letter", "quarantined"]},
    "identity": {"$ref": "#/$defs/identity"}, "bindings": {"$ref": "#/$defs/bindings"},
    "retry": {"$ref": "#/$defs/retry"}, "queue": {"$ref": "#/$defs/queue"},
    "human_gate": {"$ref": "#/$defs/humanGate"}, "provenance": {"$ref": "#/$defs/provenance"},
    "label_policy": {"$ref": "#/$defs/labelPolicy"},
    "classification": {"enum": ["not_applicable", "known_label", "unknown_candidate", "uncertain_conflict"]},
    "agent_action": {"enum": ["not_applicable", "split", "merge", "resegment", "reclassify", "drop", "no_op"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "failure_reason": {"type": ["string", "null"], "minLength": 1},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "contract_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contractRef"}},
    "evaluation": {"oneOf": [{"$ref": "#/$defs/evaluation"}, {"type": "null"}]},
    "truth_version": {"oneOf": [{"$ref": "#/$defs/truthVersion"}, {"type": "null"}]},
    "training_run": {"oneOf": [{"$ref": "#/$defs/trainingRun"}, {"type": "null"}]},
    "effect": {"$ref": "#/$defs/effect"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "state": {"enum": ["ingested", "qc_passed", "quarantined", "candidate_planned", "vlm_reviewed", "agent_corrected", "vlm_rechecked", "human_review_required", "candidate_accepted", "truth_promoted", "evaluation_truth", "training_eligible", "trained", "evaluated", "deployment_candidate", "baseline_retained", "deployed", "rolled_back"]},
    "identity": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "source_batch", "sequence", "frame_id", "camera", "split"], "properties": {"dataset_id": {"type": "string", "minLength": 1}, "source_batch": {"type": "string", "minLength": 1}, "sequence": {"type": "string", "minLength": 1}, "frame_id": {"type": "string", "minLength": 1}, "camera": {"type": "string", "minLength": 1}, "split": {"enum": ["train", "val", "test"]}}},
    "nullableSha": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["input_sha256", "output_sha256", "config_sha256", "model_sha256", "prompt_sha256"], "properties": {"input_sha256": {"$ref": "#/$defs/sha"}, "output_sha256": {"$ref": "#/$defs/sha"}, "config_sha256": {"$ref": "#/$defs/nullableSha"}, "model_sha256": {"$ref": "#/$defs/nullableSha"}, "prompt_sha256": {"$ref": "#/$defs/nullableSha"}}},
    "retry": {"type": "object", "additionalProperties": false, "required": ["attempt", "max_attempts", "retryable"], "properties": {"attempt": {"type": "integer", "minimum": 0}, "max_attempts": {"type": "integer", "minimum": 0}, "retryable": {"type": "boolean"}}},
    "queue": {"type": "object", "additionalProperties": false, "required": ["name", "depth", "high_watermark", "route"], "properties": {"name": {"type": "string", "minLength": 1}, "depth": {"type": "integer", "minimum": 0}, "high_watermark": {"type": "integer", "minimum": 1}, "route": {"enum": ["active", "backpressure", "retry", "dead_letter", "quarantine"]}}},
    "humanGate": {"type": "object", "additionalProperties": false, "required": ["required", "status", "review_event_id", "cvat_task_version", "receipt_sha256", "candidate_sha256", "source_image_sha256"], "properties": {"required": {"type": "boolean"}, "status": {"enum": ["not_required", "pending", "approved", "rejected"]}, "review_event_id": {"$ref": "#/$defs/nullableSha"}, "cvat_task_version": {"type": ["string", "null"]}, "receipt_sha256": {"$ref": "#/$defs/nullableSha"}, "candidate_sha256": {"$ref": "#/$defs/nullableSha"}, "source_image_sha256": {"$ref": "#/$defs/nullableSha"}}},
    "simulation": {"type": "object", "additionalProperties": false, "required": ["simulator", "scene", "random_seed", "version"], "properties": {"simulator": {"type": "string", "minLength": 1}, "scene": {"type": "string", "minLength": 1}, "random_seed": {"type": "integer"}, "version": {"type": "string", "minLength": 1}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_kind", "simulation", "sample_kind", "execution_mode", "external_effects_allowed"], "properties": {"source_kind": {"enum": ["real", "simulation"]}, "simulation": {"oneOf": [{"$ref": "#/$defs/simulation"}, {"type": "null"}]}, "sample_kind": {"enum": ["production", "synthetic_contract_fixture_not_production"]}, "execution_mode": {"enum": ["static_replay", "live_contract"]}, "external_effects_allowed": {"type": "boolean"}}},
    "labelPolicy": {"type": "object", "additionalProperties": false, "required": ["semantic_labels", "preserve_separate_training_labels", "downstream_target", "downstream_operation", "downstream_source_labels", "slope_default", "policy_basis"], "properties": {"semantic_labels": {"const": ["floor", "slope"]}, "preserve_separate_training_labels": {"const": true}, "downstream_target": {"const": "traversable_area"}, "downstream_operation": {"const": "union"}, "downstream_source_labels": {"const": ["floor", "slope"]}, "slope_default": {"const": "passable"}, "policy_basis": {"const": "user_defined_project_semantics"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["kind", "uri", "sha256"], "properties": {"kind": {"type": "string", "minLength": 1}, "uri": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "contractRef": {"type": "object", "additionalProperties": false, "required": ["contract_type", "schema_path", "artifact_uri", "artifact_sha256", "source_event_id"], "properties": {"contract_type": {"type": "string", "minLength": 1}, "schema_path": {"type": "string", "minLength": 1}, "artifact_uri": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha"}, "source_event_id": {"$ref": "#/$defs/nullableSha"}}},
    "metricView": {"type": "object", "additionalProperties": false, "required": ["mask_iou", "boundary_f1", "object_precision", "object_recall", "false_positives"], "properties": {"mask_iou": {"type": "number", "minimum": 0, "maximum": 1}, "boundary_f1": {"type": "number", "minimum": 0, "maximum": 1}, "object_precision": {"type": "number", "minimum": 0, "maximum": 1}, "object_recall": {"type": "number", "minimum": 0, "maximum": 1}, "false_positives": {"type": "integer", "minimum": 0}}},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["fixed_holdout_manifest_sha256", "overall", "per_class", "source_real", "source_simulation", "overall_guard_passed", "slope_guard_passed", "deployment_gate_passed"], "properties": {"fixed_holdout_manifest_sha256": {"$ref": "#/$defs/sha"}, "overall": {"$ref": "#/$defs/metricView"}, "per_class": {"type": "object", "additionalProperties": false, "required": ["floor", "slope"], "properties": {"floor": {"$ref": "#/$defs/metricView"}, "slope": {"$ref": "#/$defs/metricView"}}}, "source_real": {"$ref": "#/$defs/metricView"}, "source_simulation": {"$ref": "#/$defs/metricView"}, "overall_guard_passed": {"type": "boolean"}, "slope_guard_passed": {"type": "boolean"}, "deployment_gate_passed": {"type": "boolean"}}},
    "truthVersion": {"type": "object", "additionalProperties": false, "required": ["version_id", "manifest_sha256", "split", "immutable"], "properties": {"version_id": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha"}, "split": {"enum": ["train", "val", "test"]}, "immutable": {"const": true}}},
    "trainingRun": {"type": "object", "additionalProperties": false, "required": ["run_id", "package_sha256", "checkpoint_sha256", "simulated_static_replay"], "properties": {"run_id": {"type": "string", "minLength": 1}, "package_sha256": {"$ref": "#/$defs/sha"}, "checkpoint_sha256": {"$ref": "#/$defs/nullableSha"}, "simulated_static_replay": {"type": "boolean"}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["mode", "external_call_count", "production_mutation"], "properties": {"mode": {"enum": ["none", "simulated", "result_reference"]}, "external_call_count": {"type": "integer", "minimum": 0}, "production_mutation": {"type": "boolean"}}}
  }
}
