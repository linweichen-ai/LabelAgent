{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/labelagent_closed_loop_event.schema.json",
  "title": "LabelAgent closed-loop event protocol 1.1 with current slope policy profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "event_id", "event_type", "occurred_at", "run_id",
    "correlation_id", "idempotency_key", "workflow", "source", "producer",
    "decision", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "event_id": {"type": "string", "minLength": 8},
    "event_type": {
      "enum": [
        "frame.ingested", "quality.checked", "candidate.generated",
        "vlm.reviewed", "agent.action", "unknown.proposed",
        "ontology.reviewed", "human.reviewed", "truth.committed",
        "dataset.versioned", "evaluation.completed", "training.completed",
        "deployment.promoted", "deployment.rolled_back"
      ]
    },
    "occurred_at": {"type": "string", "format": "date-time"},
    "run_id": {"type": "string", "minLength": 8},
    "correlation_id": {"type": "string", "minLength": 8},
    "parent_event_id": {"type": ["string", "null"]},
    "idempotency_key": {"type": "string", "minLength": 16},
    "workflow": {"$ref": "#/$defs/workflow"},
    "source": {"$ref": "#/$defs/source"},
    "producer": {"$ref": "#/$defs/producer"},
    "decision": {"$ref": "#/$defs/decision"},
    "task_context": {"$ref": "#/$defs/task_context"},
    "slope_context": {"$ref": "#/$defs/slope_context"},
    "unknown_candidate": {"$ref": "#/$defs/unknown_candidate"},
    "review": {"$ref": "#/$defs/review"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "latency_ms": {"type": "number", "minimum": 0},
        "human_seconds": {"type": "number", "minimum": 0},
        "agent_rounds": {"type": "integer", "minimum": 0},
        "estimated_cost": {"type": "number", "minimum": 0},
        "slope_iou": {"type": "number", "minimum": 0, "maximum": 1},
        "slope_dice": {"type": "number", "minimum": 0, "maximum": 1},
        "slope_boundary_f1": {"type": "number", "minimum": 0, "maximum": 1},
        "slope_boundary_tolerance_px": {"type": "number", "minimum": 0},
        "slope_pixel_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "slope_pixel_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "slope_instance_precision": {"type": "number", "minimum": 0, "maximum": 1},
        "slope_instance_recall": {"type": "number", "minimum": 0, "maximum": 1},
        "slope_to_floor_confusion_pixels": {"type": "integer", "minimum": 0},
        "floor_to_slope_confusion_pixels": {"type": "integer", "minimum": 0},
        "slope_to_step_curb_confusion_pixels": {"type": "integer", "minimum": 0},
        "step_curb_to_slope_confusion_pixels": {"type": "integer", "minimum": 0},
        "slope_false_traversable_count": {"type": "integer", "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["event_type"],
        "properties": {"event_type": {"const": "unknown.proposed"}}
      },
      "then": {
        "required": ["unknown_candidate", "review"],
        "properties": {
          "workflow": {
            "properties": {"state": {"const": "ontology_review_required"}}
          },
          "decision": {
            "properties": {"status": {"const": "review_required"}}
          },
          "review": {
            "properties": {
              "required": {"const": true},
              "status": {"const": "pending"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["event_type"],
        "properties": {"event_type": {"const": "truth.committed"}}
      },
      "then": {
        "required": ["review"],
        "properties": {
          "workflow": {
            "properties": {"previous_state": {"const": "human_approved"}}
          },
          "review": {
            "required": ["required", "status", "reviewer_type", "reviewed_at"],
            "properties": {
              "required": {"const": true},
              "status": {"const": "approved"},
              "reviewer_type": {"const": "human"},
              "reviewed_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["producer", "slope_context"],
        "properties": {
          "producer": {"properties": {"component": {"enum": ["sam", "vlm", "agent"]}}, "required": ["component"]},
          "slope_context": {"properties": {"policy_override": {"properties": {"status": {"const": "non_passable"}}, "required": ["status"]}}, "required": ["policy_override"]}
        }
      },
      "then": false
    },
    {
      "if": {
        "required": ["event_type", "task_context"],
        "properties": {
          "event_type": {"const": "human.reviewed"},
          "task_context": {"properties": {"hard_case_tags": {"contains": {"const": "slope"}}}}
        }
      },
      "then": {
        "required": ["slope_context"],
        "properties": {
          "slope_context": {
            "required": ["visible_status", "candidate_sha256", "evidence_provenance", "hard_set_strata"]
          }
        }
      }
    },
    {
      "if": {
        "required": ["event_type", "task_context"],
        "properties": {
          "event_type": {"const": "evaluation.completed"},
          "task_context": {"properties": {"hard_case_tags": {"contains": {"const": "slope"}}}}
        }
      },
      "then": {
        "required": ["slope_context", "metrics"],
        "properties": {
          "slope_context": {
            "properties": {
              "human_pixel_truth_available": {"const": true},
              "hard_set_strata": {"not": {"contains": {"const": "unassigned"}}}
            },
            "required": ["visible_status", "candidate_sha256", "evidence_provenance", "hard_set_strata"]
          },
          "metrics": {
            "required": ["slope_iou", "slope_dice", "slope_boundary_f1", "slope_boundary_tolerance_px", "slope_pixel_precision", "slope_pixel_recall", "slope_instance_precision", "slope_instance_recall", "slope_to_floor_confusion_pixels", "floor_to_slope_confusion_pixels", "slope_to_step_curb_confusion_pixels", "step_curb_to_slope_confusion_pixels", "slope_false_traversable_count"]
          }
        }
      }
    }
  ],
  "$defs": {
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous_state", "state", "iteration", "max_iterations"],
      "properties": {
        "previous_state": {
          "type": ["string", "null"],
          "enum": [
            null, "ingested", "qc_passed", "quarantined",
            "candidates_generated", "vlm_reviewed", "agent_iteration",
            "auto_accepted", "review_required", "ontology_review_required",
            "ontology_versioned", "reprocess_required", "human_approved",
            "human_rejected", "truth_committed", "dataset_versioned",
            "evaluated", "trained", "deployment_candidate", "promoted",
            "rolled_back"
          ]
        },
        "state": {
          "enum": [
            "ingested", "qc_passed", "quarantined", "candidates_generated",
            "vlm_reviewed", "agent_iteration", "auto_accepted",
            "review_required", "ontology_review_required", "ontology_versioned",
            "reprocess_required", "human_approved", "human_rejected",
            "truth_committed", "dataset_versioned", "evaluated", "trained",
            "deployment_candidate", "promoted", "rolled_back"
          ]
        },
        "iteration": {"type": "integer", "minimum": 0},
        "max_iterations": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_id", "source_batch", "frame_id", "capture_time", "origin",
        "modality", "content_sha256"
      ],
      "properties": {
        "dataset_id": {"type": "string", "minLength": 1},
        "source_batch": {"type": "string", "minLength": 1},
        "frame_id": {"type": ["string", "integer"]},
        "camera": {"type": ["string", "null"]},
        "topic": {"type": ["string", "null"]},
        "capture_time": {"type": "string", "format": "date-time"},
        "origin": {"enum": ["real", "simulation"]},
        "modality": {"enum": ["image", "point_cloud", "multimodal"]},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "simulation": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "simulator": {"type": "string", "minLength": 1},
            "scene_config": {"type": "string", "minLength": 1},
            "random_seed": {"type": "integer"},
            "sensor_version": {"type": "string", "minLength": 1}
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["origin"],
            "properties": {"origin": {"const": "simulation"}}
          },
          "then": {
            "required": ["simulation"],
            "properties": {
              "simulation": {
                "type": "object",
                "required": ["simulator", "scene_config", "random_seed", "sensor_version"]
              }
            }
          }
        }
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "code_commit"],
      "properties": {
        "component": {"enum": ["ingestor", "quality_gate", "sam", "vlm", "agent", "human", "trainer", "deployer"]},
        "model_name": {"type": ["string", "null"]},
        "model_version": {"type": ["string", "null"]},
        "prompt_version": {"type": ["string", "null"]},
        "code_commit": {"type": "string", "minLength": 7},
        "ontology_version": {"type": ["string", "null"]}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confidence", "reason_codes"],
      "properties": {
        "status": {"enum": ["accepted", "rejected", "review_required", "unknown", "quarantined", "committed", "versioned", "promoted", "rolled_back"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "reason_codes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "summary": {"type": "string"}
      }
    },
    "task_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_case_tags"],
      "properties": {
        "hard_case_tags": {
          "type": "array",
          "items": {"enum": ["slope", "small_object", "occlusion", "glare", "novel_label", "model_conflict"]},
          "uniqueItems": true
        },
        "evaluation_stratum": {"type": ["string", "null"]}
      }
    },
    "downstream_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["target_label", "operation", "source_labels", "source_layer", "target_layer", "preserve_source_labels"],
      "properties": {
        "target_label": {"const": "traversable_area"},
        "operation": {"const": "union"},
        "source_labels": {"const": ["floor", "slope"]},
        "source_layer": {"const": "training_annotation"},
        "target_layer": {"const": "downstream_navigation"},
        "preserve_source_labels": {"const": true}
      }
    },
    "slope_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_label", "traversability_status", "human_pixel_truth_available"],
      "properties": {
        "semantic_label": {"const": "slope_visible"},
        "traversability_status": {"enum": ["unknown", "review_required", "traversable", "non_traversable", "passable", "non_passable"]},
        "geometry_evidence_sufficient": {"type": "boolean"},
        "geometry_evidence_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "business_mapping": {"const": "traversable_area"},
        "downstream_mapping": {"$ref": "#/$defs/downstream_mapping"},
        "policy_default": {"const": "passable"},
        "policy_basis": {"const": "user_defined_project_semantics"},
        "policy_override": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "rule_id", "reason", "decided_by", "evidence_artifact_ids"],
          "properties": {
            "status": {"enum": ["none", "non_passable"]},
            "rule_id": {"type": ["string", "null"], "minLength": 1},
            "reason": {"type": ["string", "null"], "minLength": 1},
            "decided_by": {"enum": ["human", "system_policy", null]},
            "evidence_artifact_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "human_pixel_truth_available": {"type": "boolean"},
        "approved_for_training": {"type": "boolean"},
        "visible_status": {"enum": ["candidate_supported", "human_confirmed", "human_rejected", "unknown"]},
        "candidate_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "evidence_provenance": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["kind", "source", "sha256"],
            "properties": {
              "kind": {"type": "string", "minLength": 1},
              "source": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "hard_set_strata": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"enum": ["unassigned", "near", "mid", "far", "weak_texture", "shadow", "backlight", "occlusion", "slope_foot_boundary", "slope_top_boundary"]}
        }
      },
      "oneOf": [
        {"required": ["geometry_evidence_sufficient", "geometry_evidence_artifact_ids"],
         "not": {"anyOf": [{"required": ["policy_default"]}, {"required": ["policy_basis"]}, {"required": ["policy_override"]}]}},
        {"required": ["business_mapping", "downstream_mapping", "policy_default", "policy_basis", "policy_override"],
         "not": {"anyOf": [{"required": ["geometry_evidence_sufficient"]}, {"required": ["geometry_evidence_artifact_ids"]}]}}
      ],
      "allOf": [
        {"if": {"required": ["policy_override"], "properties": {"policy_override": {"properties": {"status": {"const": "none"}}, "required": ["status"]}}},
         "then": {"properties": {"traversability_status": {"const": "passable"}, "policy_override": {"properties": {"rule_id": {"type": "null"}, "reason": {"type": "null"}, "decided_by": {"type": "null"}, "evidence_artifact_ids": {"maxItems": 0}}}}}},
        {"if": {"required": ["policy_override"], "properties": {"policy_override": {"properties": {"status": {"const": "non_passable"}}, "required": ["status"]}}},
         "then": {"properties": {"traversability_status": {"const": "non_passable"}, "policy_override": {"properties": {"rule_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "decided_by": {"enum": ["human", "system_policy"]}}}}}}
      ]
    },
    "unknown_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "proposed_name", "confidence", "nearest_known_labels", "evidence_artifact_ids", "ontology_mutation_allowed"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 8},
        "proposed_name": {"type": "string", "minLength": 1},
        "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "nearest_known_labels": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "similarity", "difference"],
            "properties": {
              "label": {"type": "string"},
              "similarity": {"type": "number", "minimum": 0, "maximum": 1},
              "difference": {"type": "string", "minLength": 1}
            }
          }
        },
        "evidence_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "recommended_action": {"enum": ["merge_existing", "create_new", "hold_unknown", "reject"]},
        "ontology_mutation_allowed": {"const": false}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "pending", "approved", "rejected"]},
        "reason": {"type": "string"},
        "reviewer_type": {"enum": ["none", "human", "policy"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "kind", "uri", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 8},
        "kind": {"enum": ["image", "point_cloud", "mask", "box", "label_json", "agent_trace", "report", "model"]},
        "uri": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
