{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/formal-ddp-preflight-input.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "input_id", "observed_at", "execution_contract", "truth_gate", "holdout_gate", "stage0_gate", "resource_gate", "path_gate", "formal_training_authorized"],
  "properties": {
    "schema_version": {"const": "labelagent.formal-ddp-preflight-input.v1"},
    "input_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "execution_contract": {
      "const": {"mode": "one_shot_read_only_no_polling", "auto_start_when_idle": false}
    },
    "truth_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["truth_version_available", "truth_version_id", "truth_manifest_sha256", "truth_manifest_sha256_verified"],
      "properties": {
        "truth_version_available": {"type": "boolean"},
        "truth_version_id": {"type": ["string", "null"]},
        "truth_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "truth_manifest_sha256_verified": {"type": "boolean"}
      }
    },
    "holdout_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["fixed_independent_baseline_available", "baseline_receipt_path", "protected_from_training"],
      "properties": {
        "fixed_independent_baseline_available": {"type": "boolean"},
        "baseline_receipt_path": {"type": ["string", "null"]},
        "protected_from_training": {"type": "boolean"}
      }
    },
    "stage0_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["exact_parameter_names", "tensor_count", "parameter_count", "exact_names_sha256", "config_path", "config_sha256", "training_config_executable"],
      "properties": {
        "exact_parameter_names": {"const": [
          "segmentation_head.mask_predictor.mask_embed.layers.0.weight",
          "segmentation_head.mask_predictor.mask_embed.layers.0.bias",
          "segmentation_head.mask_predictor.mask_embed.layers.1.weight",
          "segmentation_head.mask_predictor.mask_embed.layers.1.bias",
          "segmentation_head.mask_predictor.mask_embed.layers.2.weight",
          "segmentation_head.mask_predictor.mask_embed.layers.2.bias"
        ]},
        "tensor_count": {"const": 6},
        "parameter_count": {"const": 197376},
        "exact_names_sha256": {"const": "efacf600a68248109986db8b610f9861a8255e586aa64a2909cfcaeaded686a1"},
        "config_path": {"type": "string", "minLength": 1},
        "config_sha256": {"$ref": "#/$defs/hash"},
        "training_config_executable": {"type": "boolean"}
      }
    },
    "resource_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["dual_5090", "other_user_processes", "factory_4090_baseline"],
      "properties": {
        "dual_5090": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/gpu"}},
        "other_user_processes": {"type": "array", "items": {"$ref": "#/$defs/process"}},
        "factory_4090_baseline": {
          "type": "object", "additionalProperties": false,
          "required": ["sam3_healthy", "vlm_healthy", "new_work_scheduled", "mutation_performed"],
          "properties": {
            "sam3_healthy": {"type": "boolean"},
            "vlm_healthy": {"type": "boolean"},
            "new_work_scheduled": {"type": "boolean"},
            "mutation_performed": {"type": "boolean"}
          }
        }
      }
    },
    "path_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["output_path", "rollback_checkpoint_path", "rollback_checkpoint_sha256", "rollback_checkpoint_verified"],
      "properties": {
        "output_path": {"type": ["string", "null"]},
        "rollback_checkpoint_path": {"type": ["string", "null"]},
        "rollback_checkpoint_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "rollback_checkpoint_verified": {"type": "boolean"}
      }
    },
    "formal_training_authorized": {"type": "boolean"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gpu": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "uuid", "memory_used_mib", "utilization_percent"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 1},
        "uuid": {"type": "string", "pattern": "^GPU-"},
        "memory_used_mib": {"type": "integer", "minimum": 0},
        "utilization_percent": {"type": "integer", "minimum": 0, "maximum": 100}
      }
    },
    "process": {
      "type": "object", "additionalProperties": false,
      "required": ["pid", "owner", "command"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "owner": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1}
      }
    }
  }
}
