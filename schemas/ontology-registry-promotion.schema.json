{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://labelagent.local/schemas/ontology-registry-promotion.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_type", "occurred_at", "proposal_event_id", "parent_registry_version", "parent_registry_sha256", "proposal", "human_decision", "regression_validation", "new_registry", "replay_plan", "write_policy", "idempotency_key", "event_id"],
  "properties": {
    "schema_version": {"const": "labelagent.ontology-registry-promotion.v1"}, "event_type": {"const": "ontology.registry.version.promoted"}, "occurred_at": {"type": "string", "format": "date-time"}, "proposal_event_id": {"$ref": "#/$defs/sha"}, "parent_registry_version": {"type": "string", "minLength": 1}, "parent_registry_sha256": {"$ref": "#/$defs/sha"},
    "proposal": {"type": "object"}, "human_decision": {"type": "object", "required": ["decision", "canonical_name", "definition", "class_id", "reviewer_id", "identity_assurance", "reviewed_at", "approval_id", "receipt_uri", "receipt_sha256"], "properties": {"decision": {"const": "approved_create_new_label"}, "canonical_name": {"type": "string", "minLength": 1}, "definition": {"type": "string", "minLength": 1}, "class_id": {"type": "integer", "minimum": 1}, "reviewer_id": {"type": "string", "minLength": 1}, "identity_assurance": {"const": "authenticated"}, "reviewed_at": {"type": "string", "format": "date-time"}, "approval_id": {"type": "string", "minLength": 1}, "receipt_uri": {"type": "string", "minLength": 1}, "receipt_sha256": {"$ref": "#/$defs/sha"}}},
    "regression_validation": {"type": "object", "required": ["fixed_set_id", "manifest_uri", "manifest_sha256", "config_sha256", "real_metrics", "simulation_metrics", "truth_versions", "all_required_gates_passed", "validated_at"], "properties": {"fixed_set_id": {"type": "string", "minLength": 1}, "manifest_uri": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha"}, "config_sha256": {"$ref": "#/$defs/sha"}, "real_metrics": {"$ref": "#/$defs/metrics"}, "simulation_metrics": {"$ref": "#/$defs/metrics"}, "truth_versions": {"type": "object", "additionalProperties": false, "required": ["real", "simulation"], "properties": {"real": {"type": "string", "minLength": 1}, "simulation": {"type": "string", "minLength": 1}}}, "all_required_gates_passed": {"const": true}, "validated_at": {"type": "string", "format": "date-time"}}},
    "new_registry": {"$ref": "#/$defs/registry"},
    "replay_plan": {"$ref": "#/$defs/replay"}, "write_policy": {"const": {"mode": "append_only_new_registry_version", "overwrite_parent_registry": false}}, "idempotency_key": {"$ref": "#/$defs/sha"}, "event_id": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "metrics": {"type": "object", "additionalProperties": false, "required": ["sample_count", "precision", "recall", "false_positive_rate"], "properties": {"sample_count": {"type": "integer", "minimum": 0}, "precision": {"type": "number", "minimum": 0, "maximum": 1}, "recall": {"type": "number", "minimum": 0, "maximum": 1}, "false_positive_rate": {"type": "number", "minimum": 0, "maximum": 1}}}, "registry": {"type": "object", "additionalProperties": false, "required": ["schema_version", "registry_version", "append_only", "labels", "training_semantics", "downstream_mapping", "unknown_policy", "registry_content_sha256"], "properties": {"schema_version": {"const": "labelagent.label-registry.v1"}, "registry_version": {"type": "string", "minLength": 1}, "append_only": {"const": true}, "labels": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "object", "additionalProperties": false, "required": ["class_id", "name", "training_label"], "properties": {"class_id": {"type": "integer", "minimum": 1}, "name": {"type": "string", "minLength": 1}, "training_label": {"const": true}}}}, "training_semantics": {"const": {"floor_slope_distinct": true, "permanent_merge_allowed": false}}, "downstream_mapping": {"const": {"target_label": "traversable_area", "operation": "union", "source_labels": ["floor", "slope"], "source_layer": "training_annotation", "target_layer": "downstream_navigation", "preserve_source_labels": true}}, "unknown_policy": {"const": {"unknown": "human_review_required", "new_label_candidate": "human_review_required", "ontology_mutation_allowed": false, "automatic_truth_promotion": false}}, "registry_content_sha256": {"$ref": "#/$defs/sha"}}}, "replay": {"type": "object", "additionalProperties": false, "required": ["schema_version", "plan_id", "source_registry_version", "target_registry_version", "affected_candidate_event_ids", "source_partitions", "execution_status", "automatic_truth_promotion", "write_policy"], "properties": {"schema_version": {"const": "labelagent.ontology-replay-plan.v1"}, "plan_id": {"$ref": "#/$defs/sha"}, "source_registry_version": {"type": "string", "minLength": 1}, "target_registry_version": {"type": "string", "minLength": 1}, "affected_candidate_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}}, "source_partitions": {"type": "object"}, "execution_status": {"const": "planned_not_executed"}, "automatic_truth_promotion": {"const": false}, "write_policy": {"const": {"mode": "append_only_new_outputs", "overwrite_history": false}}}}}
}
