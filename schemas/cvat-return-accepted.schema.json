{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/cvat-return-accepted.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_type", "occurred_at", "export_event_id", "dataset_role", "split", "annotation_export_sha256", "truth_promotion_event", "training_return_allowed", "idempotency_key", "event_id"],
  "properties": {
    "schema_version": {"const": "labelagent.cvat-return-accepted.v1"},
    "event_type": {"const": "cvat.review.return.accepted"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "export_event_id": {"$ref": "#/$defs/sha"}, "dataset_role": {"const": "train72"}, "split": {"const": "train"},
    "annotation_export_sha256": {"$ref": "#/$defs/sha"},
    "truth_promotion_event": {"type": "object", "required": ["schema_version", "event_type", "version", "review", "event_id"], "properties": {"schema_version": {"const": "labelagent.truth-promotion-event.v1"}, "event_type": {"const": "truth.version.promoted"}, "version": {"type": "object", "required": ["split", "immutable", "append_only", "overwrite_previous_truth"], "properties": {"split": {"const": "train"}, "immutable": {"const": true}, "append_only": {"const": true}, "overwrite_previous_truth": {"const": false}}}, "review": {"type": "object", "required": ["review_origin", "identity_assurance"], "properties": {"review_origin": {"const": "genuine_human_review"}, "identity_assurance": {"const": "authenticated"}}}, "event_id": {"$ref": "#/$defs/sha"}}},
    "training_return_allowed": {"const": true}, "idempotency_key": {"$ref": "#/$defs/sha"}, "event_id": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
