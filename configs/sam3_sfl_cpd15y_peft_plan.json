{
  "schema_version": "labelagent.sam3-peft-plan.v1",
  "execution_enabled": false,
  "blocked_reason": "genuine human-confirmed _annotations.coco.json and live dual-5090 DDP smoke are not available",
  "base_training_config_reference_only": "source/sam3/sam3/train/configs/roboflow_v100/roboflow_v100_full_ft_100_images.yaml",
  "base_config_requires_freeze_override": true,
  "staged_unfreeze_config": "configs/sam3_sfl_cpd15y_staged_unfreeze.json",
  "strategy": {
    "selected_route": "supervised_parameter_efficient_finetuning",
    "post_training_taxonomy": "peft_is_a_specific_supervised_post_training_subtype",
    "rejected_route": "ambiguous_or_full_model_post_training",
    "phase1_goal": "validate_mask_embed_stage0_before_any_conditional_expansion",
    "broader_unfreezing_policy": "conditional_only_after_dual_5090_named_parameters_human_truth_and_fixed_holdout_baseline"
  },
  "model": {
    "checkpoint_source": "existing_verified_sam3_checkpoint_only",
    "load_from_hf": false,
    "enable_segmentation": true,
    "freeze_prefixes": ["backbone.vision_backbone.", "backbone.language_backbone."],
    "verified_trainable_scope": {
      "status": "only_currently_verified_scope",
      "prefixes": ["segmentation_head.mask_predictor.mask_embed."]
    },
    "stage0_is_minimal_baseline": true,
    "stage0_is_final_upper_bound": false,
    "conditional_expansion": {
      "enabled": false,
      "predeclared_trainable_prefixes": [],
      "requires": ["dual_5090_named_parameters_inventory", "genuine_human_truth_version", "fixed_holdout_baseline"],
      "may_target_only_after_runtime_confirmation": ["confirmed_upper_decoder_named_parameters", "newly_implemented_and_verified_adapter_named_parameters"]
    },
    "unverified_module_claims": {
      "mask_decoder_trainable": false,
      "adapter_exists_or_trainable": false,
      "lora_exists_or_trainable": false
    },
    "full_model_training": false
  },
  "loss": {
    "required_class": "sam3.train.loss.loss_fns.Masks",
    "required_terms": ["loss_mask", "loss_dice"],
    "status": "must_be_instantiated_and_forward_backward_verified_before_authorization"
  },
  "data": {
    "train_images": 72,
    "test_images": 24,
    "train_annotation_required": "train/_annotations.coco.json",
    "test_annotation_required": "test/_annotations.coco.json",
    "forbidden_as_truth": ["train/_preannotations.coco.json", "test/_preannotations.coco.json", "bev_3d_boxes"],
    "current_96_pack_classes": ["pallet", "person"],
    "slope_improvement_claim_allowed": false,
    "slope_truth_requirement": "separate_human_confirmed_slope_pixel_mask_set",
    "training_labels": ["floor", "slope"],
    "downstream_mapping": "traversable_area=floor_union_slope",
    "fixed_640_holdout_in_training": false,
    "test24_in_training": false
  },
  "distributed": {
    "backend": "nccl",
    "nodes": 1,
    "gpus_per_node": 2,
    "world_size": 2,
    "synchronous_ddp": true
  },
  "budget": {
    "precision": "bf16_pending_live_support_readback",
    "batch_size_per_gpu": 1,
    "gradient_accumulation_steps": 1,
    "activation_checkpointing": true,
    "first_batch_memory_measurement_required": true
  },
  "checkpointing": {
    "save_enabled": true,
    "rank0_only": true,
    "record_base_and_output_sha256": true
  },
  "launch_gate": {
    "formal_training_authorized": false,
    "require_human_truth_manifest": true,
    "require_split_isolation_readback": true,
    "require_live_dual_gpu_smoke": true,
    "without_human_truth_allowed": ["config_validation", "manifest_validation", "module_inventory", "one_shot_dual_5090_ddp_init_smoke"],
    "without_human_truth_forbidden": ["optimizer_step", "training_metrics", "checkpoint", "performance_claim"]
  }
}
