{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "execution_enabled", "blocked_reason", "base_training_config_reference_only", "base_config_requires_freeze_override", "staged_unfreeze_config", "strategy", "model", "loss", "data", "distributed", "budget", "checkpointing", "launch_gate"],
  "properties": {
    "schema_version": {"const": "labelagent.sam3-peft-plan.v1"},
    "execution_enabled": {"const": false},
    "blocked_reason": {"type": "string", "minLength": 1},
    "base_training_config_reference_only": {"const": "source/sam3/sam3/train/configs/roboflow_v100/roboflow_v100_full_ft_100_images.yaml"},
    "base_config_requires_freeze_override": {"const": true},
    "staged_unfreeze_config": {"const": "configs/sam3_sfl_cpd15y_staged_unfreeze.json"},
    "strategy": {"type": "object", "additionalProperties": false, "required": ["selected_route", "post_training_taxonomy", "rejected_route", "phase1_goal", "broader_unfreezing_policy"], "properties": {
      "selected_route": {"const": "supervised_parameter_efficient_finetuning"},
      "post_training_taxonomy": {"const": "peft_is_a_specific_supervised_post_training_subtype"},
      "rejected_route": {"const": "ambiguous_or_full_model_post_training"},
      "phase1_goal": {"const": "validate_mask_embed_stage0_before_any_conditional_expansion"},
      "broader_unfreezing_policy": {"const": "conditional_only_after_dual_5090_named_parameters_human_truth_and_fixed_holdout_baseline"}
    }},
    "model": {"type": "object", "additionalProperties": false, "required": ["checkpoint_source", "load_from_hf", "enable_segmentation", "freeze_prefixes", "verified_trainable_scope", "stage0_is_minimal_baseline", "stage0_is_final_upper_bound", "conditional_expansion", "unverified_module_claims", "full_model_training"], "properties": {
      "checkpoint_source": {"const": "existing_verified_sam3_checkpoint_only"}, "load_from_hf": {"const": false}, "enable_segmentation": {"const": true},
      "freeze_prefixes": {"const": ["backbone.vision_backbone.", "backbone.language_backbone."]},
      "verified_trainable_scope": {"type": "object", "additionalProperties": false, "required": ["status", "prefixes"], "properties": {
        "status": {"const": "only_currently_verified_scope"},
        "prefixes": {"const": ["segmentation_head.mask_predictor.mask_embed."]}
      }},
      "stage0_is_minimal_baseline": {"const": true},
      "stage0_is_final_upper_bound": {"const": false},
      "conditional_expansion": {"type": "object", "additionalProperties": false, "required": ["enabled", "predeclared_trainable_prefixes", "requires", "predeclared_module_families", "future_scope_generation"], "properties": {
        "enabled": {"const": false},
        "predeclared_trainable_prefixes": {"const": []},
        "requires": {"const": ["dual_5090_named_parameters_inventory", "genuine_human_truth_version", "fixed_holdout_baseline"]},
        "predeclared_module_families": {"const": []},
        "future_scope_generation": {"const": "new_config_from_dual_5090_exact_named_parameters_only_after_all_prerequisites"}
      }},
      "unverified_module_claims": {"type": "object", "additionalProperties": false, "required": ["mask_decoder_trainable", "adapter_exists_or_trainable", "lora_exists_or_trainable"], "properties": {
        "mask_decoder_trainable": {"const": false},
        "adapter_exists_or_trainable": {"const": false},
        "lora_exists_or_trainable": {"const": false}
      }},
      "full_model_training": {"const": false}
    }},
    "loss": {"type": "object", "additionalProperties": false, "required": ["required_class", "required_terms", "status"], "properties": {
      "required_class": {"const": "sam3.train.loss.loss_fns.Masks"}, "required_terms": {"const": ["loss_mask", "loss_dice"]},
      "status": {"const": "must_be_instantiated_and_forward_backward_verified_before_authorization"}
    }},
    "data": {"type": "object", "additionalProperties": false, "required": ["train_images", "test_images", "train_annotation_required", "test_annotation_required", "forbidden_as_truth", "current_96_pack_classes", "slope_improvement_claim_allowed", "slope_truth_requirement", "training_labels", "downstream_mapping", "fixed_640_holdout_in_training", "test24_in_training"], "properties": {
      "train_images": {"const": 72}, "test_images": {"const": 24}, "train_annotation_required": {"const": "train/_annotations.coco.json"}, "test_annotation_required": {"const": "test/_annotations.coco.json"},
      "forbidden_as_truth": {"const": ["train/_preannotations.coco.json", "test/_preannotations.coco.json", "bev_3d_boxes"]},
      "current_96_pack_classes": {"const": ["pallet", "person"]},
      "slope_improvement_claim_allowed": {"const": false},
      "slope_truth_requirement": {"const": "separate_human_confirmed_slope_pixel_mask_set"},
      "training_labels": {"const": ["floor", "slope"]},
      "downstream_mapping": {"const": "traversable_area=floor_union_slope"},
      "fixed_640_holdout_in_training": {"const": false}, "test24_in_training": {"const": false}
    }},
    "distributed": {"type": "object", "additionalProperties": false, "required": ["backend", "nodes", "gpus_per_node", "world_size", "synchronous_ddp"], "properties": {
      "backend": {"const": "nccl"}, "nodes": {"const": 1}, "gpus_per_node": {"const": 2}, "world_size": {"const": 2}, "synchronous_ddp": {"const": true}
    }},
    "budget": {"type": "object", "additionalProperties": false, "required": ["precision", "batch_size_per_gpu", "gradient_accumulation_steps", "activation_checkpointing", "first_batch_memory_measurement_required"], "properties": {
      "precision": {"const": "bf16_verified_one_shot_no_training"}, "batch_size_per_gpu": {"const": 1}, "gradient_accumulation_steps": {"const": 1}, "activation_checkpointing": {"const": true}, "first_batch_memory_measurement_required": {"const": true}
    }},
    "checkpointing": {"type": "object", "additionalProperties": false, "required": ["save_enabled", "rank0_only", "record_base_and_output_sha256"], "properties": {
      "save_enabled": {"const": true}, "rank0_only": {"const": true}, "record_base_and_output_sha256": {"const": true}
    }},
    "launch_gate": {"type": "object", "additionalProperties": false, "required": ["formal_training_authorized", "require_human_truth_manifest", "require_split_isolation_readback", "require_live_dual_gpu_smoke", "without_human_truth_allowed", "without_human_truth_forbidden"], "properties": {
      "formal_training_authorized": {"const": false}, "require_human_truth_manifest": {"const": true}, "require_split_isolation_readback": {"const": true}, "require_live_dual_gpu_smoke": {"const": true},
      "without_human_truth_allowed": {"const": ["config_validation", "manifest_validation", "module_inventory", "one_shot_dual_5090_ddp_init_smoke"]},
      "without_human_truth_forbidden": {"const": ["optimizer_step", "training_metrics", "checkpoint", "performance_claim"]}
    }}
  }
}
