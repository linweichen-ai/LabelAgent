{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/factory-data-qc-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_type", "occurred_at", "input_id", "ingress_event_id", "idempotency_key", "policy", "checks", "outcome", "candidate_pipeline_allowed", "quarantine", "silent_skip", "write_policy", "event_id"],
  "properties": {
    "schema_version": {"const": "labelagent.factory-qc-event.v1"},
    "event_type": {"const": "factory.frame_bundle.qc"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "input_id": {"$ref": "#/$defs/hash"},
    "ingress_event_id": {"$ref": "#/$defs/hash"},
    "idempotency_key": {"$ref": "#/$defs/hash"},
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["policy_version", "policy_sha256", "max_camera_timestamp_delta_ms", "max_pose_gap_ms", "max_odom_gap_ms"],
      "properties": {
        "policy_version": {"type": "string", "minLength": 1},
        "policy_sha256": {"$ref": "#/$defs/hash"},
        "max_camera_timestamp_delta_ms": {"type": "number", "minimum": 0},
        "max_pose_gap_ms": {"type": "number", "minimum": 0},
        "max_odom_gap_ms": {"type": "number", "minimum": 0}
      }
    },
    "checks": {
      "type": "array", "minItems": 7, "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "file_integrity"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "four_camera_completeness"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "camera_frame_alignment"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "timestamp_alignment"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "calibration_presence"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "calibration_version_consistency"}}}]},
        {"allOf": [{"$ref": "#/$defs/check"}, {"properties": {"check_id": {"const": "pose_odom_continuity"}}}]}
      ],
      "items": false
    },
    "outcome": {"enum": ["passed", "quarantined"]},
    "candidate_pipeline_allowed": {"type": "boolean"},
    "quarantine": {"oneOf": [{"$ref": "#/$defs/quarantine"}, {"type": "null"}]},
    "silent_skip": {"const": false},
    "write_policy": {"const": {"mode": "append_only", "overwrite_qc": false, "overwrite_source": false}},
    "event_id": {"$ref": "#/$defs/hash"}
  },
  "allOf": [
    {"if": {"properties": {"outcome": {"const": "passed"}}}, "then": {"properties": {"candidate_pipeline_allowed": {"const": true}, "quarantine": {"type": "null"}}}},
    {"if": {"properties": {"outcome": {"const": "quarantined"}}}, "then": {"properties": {"candidate_pipeline_allowed": {"const": false}, "quarantine": {"$ref": "#/$defs/quarantine"}}}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["check_id", "status", "reason_code", "observed", "evidence_artifact_ids"],
      "properties": {
        "check_id": {"enum": ["file_integrity", "four_camera_completeness", "camera_frame_alignment", "timestamp_alignment", "calibration_presence", "calibration_version_consistency", "pose_odom_continuity"]},
        "status": {"enum": ["pass", "fail"]},
        "reason_code": {"type": ["string", "null"]},
        "observed": {"type": "string", "minLength": 1},
        "evidence_artifact_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "pass"}}}, "then": {"properties": {"reason_code": {"type": "null"}}}},
        {"if": {"properties": {"status": {"const": "fail"}}}, "then": {"properties": {"reason_code": {"type": "string", "minLength": 1}}}}
      ]
    },
    "quarantine": {
      "type": "object", "additionalProperties": false,
      "required": ["quarantine_id", "ingress_event_id", "failed_check_ids", "reason_codes", "path", "write_mode", "release_allowed", "silent_skip", "required_action"],
      "properties": {
        "quarantine_id": {"$ref": "#/$defs/hash"},
        "ingress_event_id": {"$ref": "#/$defs/hash"},
        "failed_check_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "reason_codes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "path": {"type": "string", "pattern": "^quarantine/"},
        "write_mode": {"const": "append_only"},
        "release_allowed": {"const": false},
        "silent_skip": {"const": false},
        "required_action": {"const": "human_review_or_reingest"}
      }
    }
  }
}
