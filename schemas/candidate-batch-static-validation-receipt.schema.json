{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "execution", "tool", "config", "manifests", "routing", "write_policy", "validation_passed"],
  "properties": {
    "schema_version": {"const": "labelagent.candidate-batch-static-validation-receipt.v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "execution": {
      "const": {
        "mode": "static_cpu_hashing_only",
        "gpu_calls": 0,
        "model_calls": 0,
        "remote_writes": false,
        "candidate_outputs_written": false,
        "human_truth_modified": false
      }
    },
    "tool": {"$ref": "#/$defs/artifact"},
    "config": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "execution_enabled"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "execution_enabled": {"const": false}
      }
    },
    "manifests": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["split", "path", "file_sha256", "manifest_content_sha256", "entry_count", "evaluation_only", "training_return_allowed"],
        "properties": {
          "split": {"enum": ["train72", "test24"]},
          "path": {"type": "string", "minLength": 1},
          "file_sha256": {"$ref": "#/$defs/hash"},
          "manifest_content_sha256": {"$ref": "#/$defs/hash"},
          "entry_count": {"enum": [72, 24]},
          "evaluation_only": {"type": "boolean"},
          "training_return_allowed": {"const": false}
        }
      }
    },
    "routing": {"const": {
      "new_label_or_unknown": "human_review_required",
      "low_confidence": "human_review_required",
      "vlm_sam_conflict": "human_review_required",
      "automatic_truth_promotion": false
    }},
    "write_policy": {"const": {
      "mode": "append_only_explicit_new_version",
      "overwrite_human_truth": false
    }},
    "validation_passed": {"const": true}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
