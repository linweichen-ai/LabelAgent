{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://labelagent.local/schemas/vlm-label-observation.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "event_type", "observed_at", "identity", "provenance", "inputs", "registry_binding", "result", "routing", "ontology_mutation_allowed", "truth_promotion_allowed", "write_policy", "idempotency_key", "event_id"],
  "properties": {
    "schema_version": {"const": "labelagent.vlm-label-observation.v1"}, "event_type": {"const": "vlm.label_observation.recorded"}, "observed_at": {"type": "string", "format": "date-time"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "source_batch", "sequence", "frame_id", "input_id"], "properties": {"dataset_id": {"type": "string", "minLength": 1}, "source_batch": {"type": "string", "minLength": 1}, "sequence": {"type": "string", "minLength": 1}, "frame_id": {"type": "string", "minLength": 1}, "input_id": {"$ref": "#/$defs/sha"}}},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_kind", "simulation"], "properties": {"source_kind": {"enum": ["real", "simulation"]}, "simulation": {"type": ["object", "null"]}}},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["views", "candidate", "model", "prompt"], "properties": {"views": {"type": "array", "minItems": 2, "items": {"type": "object"}}, "candidate": {"type": "object"}, "model": {"$ref": "#/$defs/versioned"}, "prompt": {"$ref": "#/$defs/versioned"}}},
    "registry_binding": {"type": "object", "additionalProperties": false, "required": ["registry_version", "registry_sha256"], "properties": {"registry_version": {"type": "string", "minLength": 1}, "registry_sha256": {"$ref": "#/$defs/sha"}}},
    "result": {"type": "object", "additionalProperties": false, "required": ["outcome", "proposed_name", "aliases", "nearest_known_labels", "evidence", "confidence", "multiview_consistency", "sam_relation"], "properties": {"outcome": {"enum": ["known_label", "unknown_candidate", "uncertain_conflict"]}, "proposed_name": {"type": "string", "minLength": 1}, "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "nearest_known_labels": {"type": "array", "items": {"type": "object"}}, "evidence": {"type": "object"}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "multiview_consistency": {"type": "object"}, "sam_relation": {"enum": ["consistent", "conflict", "insufficient_evidence"]}}},
    "routing": {"type": "object", "additionalProperties": false, "required": ["confidence_threshold", "human_review_required", "reason_codes", "next_state"], "properties": {"confidence_threshold": {"type": "number", "minimum": 0, "maximum": 1}, "human_review_required": {"type": "boolean"}, "reason_codes": {"type": "array", "uniqueItems": true, "items": {"enum": ["UNKNOWN_OR_NEW_LABEL", "UNCERTAIN_OR_CONFLICT", "LOW_CONFIDENCE", "SAM_ONTOLOGY_CONFLICT"]}}, "next_state": {"enum": ["human_review_required", "known_label_candidate"]}}},
    "ontology_mutation_allowed": {"const": false}, "truth_promotion_allowed": {"const": false},
    "write_policy": {"const": {"mode": "append_only", "overwrite_registry": false}}, "idempotency_key": {"$ref": "#/$defs/sha"}, "event_id": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "versioned": {"type": "object", "additionalProperties": false, "required": ["id", "version", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}}
}
