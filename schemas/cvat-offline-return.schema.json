{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labelagent.local/schemas/cvat-offline-return.schema.json",
  "title": "Offline CVAT human-completed return",
  "type": "object", "additionalProperties": false,
  "required": ["export_event_id", "dataset_role", "split", "identity", "cvat_binding", "completion", "artifact_bindings", "annotation_export", "annotation_labels", "before_after_diff", "truth", "version", "approval"],
  "properties": {
    "export_event_id": {"$ref": "#/$defs/sha"}, "dataset_role": {"enum": ["train72", "test24"]}, "split": {"enum": ["train", "test"]},
    "identity": {"type": "object", "additionalProperties": false, "required": ["dataset_id", "source_batch", "sequence", "frame_id", "camera", "input_id"], "properties": {"dataset_id": {"type": "string", "minLength": 1}, "source_batch": {"type": "string", "minLength": 1}, "sequence": {"type": "string", "minLength": 1}, "frame_id": {"type": "string", "minLength": 1}, "camera": {"type": "string", "minLength": 1}, "input_id": {"$ref": "#/$defs/sha"}}},
    "cvat_binding": {"type": "object", "additionalProperties": false, "required": ["task_id", "job_id", "task_version", "job_version", "package_version"], "properties": {"task_id": {"type": "string", "minLength": 1}, "job_id": {"type": "string", "minLength": 1}, "task_version": {"type": "string", "minLength": 1}, "job_version": {"type": "string", "minLength": 1}, "package_version": {"type": "string", "minLength": 1}}},
    "completion": {"type": "object", "additionalProperties": false, "required": ["status", "actor_type", "reviewer", "decision"], "properties": {"status": {"const": "human_completed"}, "actor_type": {"const": "human"}, "reviewer": {"type": "object", "additionalProperties": false, "required": ["reviewer_id", "identity_assurance", "reviewed_at"], "properties": {"reviewer_id": {"type": "string", "minLength": 1}, "identity_assurance": {"const": "authenticated"}, "reviewed_at": {"type": "string", "format": "date-time"}}}, "decision": {"enum": ["accepted", "corrected"]}}},
    "artifact_bindings": {"type": "object", "additionalProperties": false, "required": ["source_image_sha256", "input_sha256", "candidate_sha256", "model_sha256", "config_sha256", "label_registry_sha256"], "properties": {"source_image_sha256": {"$ref": "#/$defs/sha"}, "input_sha256": {"$ref": "#/$defs/sha"}, "candidate_sha256": {"$ref": "#/$defs/sha"}, "model_sha256": {"$ref": "#/$defs/sha"}, "config_sha256": {"$ref": "#/$defs/sha"}, "label_registry_sha256": {"$ref": "#/$defs/sha"}}},
    "annotation_export": {"type": "object", "additionalProperties": false, "required": ["uri", "sha256", "verified_sha256"], "properties": {"uri": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}, "verified_sha256": {"$ref": "#/$defs/sha"}}},
    "annotation_labels": {"type": "array", "uniqueItems": true, "items": {"enum": ["pallet", "person", "floor", "slope", "ego", "other_robot", "cargo_floor"]}},
    "before_after_diff": {"type": "object", "additionalProperties": false, "required": ["artifact_uri", "artifact_sha256", "before_sha256", "after_sha256", "added", "removed", "modified"], "properties": {"artifact_uri": {"type": "string", "minLength": 1}, "artifact_sha256": {"$ref": "#/$defs/sha"}, "before_sha256": {"$ref": "#/$defs/sha"}, "after_sha256": {"$ref": "#/$defs/sha"}, "added": {"type": "integer", "minimum": 0}, "removed": {"type": "integer", "minimum": 0}, "modified": {"type": "integer", "minimum": 0}}},
    "truth": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "uri", "sha256"], "properties": {"artifact_id": {"$ref": "#/$defs/sha"}, "uri": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}},
    "version": {"type": "object", "additionalProperties": false, "required": ["version_id", "parent_version", "split", "manifest_uri", "manifest_sha256", "truth_sha256", "immutable", "append_only", "overwrite_previous_truth", "previous_truth_preserved"], "properties": {"version_id": {"type": "string", "minLength": 1}, "parent_version": {"type": "string", "minLength": 1}, "split": {"enum": ["train", "test"]}, "manifest_uri": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha"}, "truth_sha256": {"$ref": "#/$defs/sha"}, "immutable": {"const": true}, "append_only": {"const": true}, "overwrite_previous_truth": {"const": false}, "previous_truth_preserved": {"const": true}}},
    "approval": {"type": "object", "additionalProperties": false, "required": ["approval_id", "decision", "reviewer_id", "approved_at", "receipt_uri", "receipt_sha256", "annotation_export_sha256", "truth_sha256"], "properties": {"approval_id": {"type": "string", "minLength": 1}, "decision": {"const": "approved"}, "reviewer_id": {"type": "string", "minLength": 1}, "approved_at": {"type": "string", "format": "date-time"}, "receipt_uri": {"type": "string", "minLength": 1}, "receipt_sha256": {"$ref": "#/$defs/sha"}, "annotation_export_sha256": {"$ref": "#/$defs/sha"}, "truth_sha256": {"$ref": "#/$defs/sha"}}}
  },
  "allOf": [
    {"if": {"properties": {"dataset_role": {"const": "train72"}}}, "then": {"properties": {"split": {"const": "train"}, "version": {"properties": {"split": {"const": "train"}}}}}},
    {"if": {"properties": {"dataset_role": {"const": "test24"}}}, "then": {"properties": {"split": {"const": "test"}, "version": {"properties": {"split": {"const": "test"}}}}}}
  ],
  "$defs": {"sha": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
